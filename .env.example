APP_NAME="Dainely"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Live hosting only: absolute path to web docroot if not public/ (e.g. dev.dainelylab.com folder)
# APP_PUBLIC_PATH=
APP_LOCALE=en
APP_SUPPORTED_LOCALES=en,fr,de

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supabase PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

# Supabase dedicated connection (catalog sync tables)
# Prefer Session mode pooler from shared hosting (not db.PROJECT.supabase.co)
DB_SUPABASE_HOST=aws-0-us-west-2.pooler.supabase.com
DB_SUPABASE_PORT=5432
DB_SUPABASE_DATABASE=postgres
DB_SUPABASE_USERNAME=postgres.xxxxxxxxxxxx
DB_SUPABASE_PASSWORD=
DB_SUPABASE_SSLMODE=require
# Remote hosts: keep low (5) so hung TCP fails before PHP max_execution_time (30).
DB_SUPABASE_TIMEOUT=5

# Set false on hosts without pdo_pgsql (Shopify catalog still works)
FEATURES_SUPABASE=true

# Supabase API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
# Optional: redis in production for shared storefront cache
# CACHE_DRIVER=redis

# Cloudflare edge HTML cache headers (blog/education/static CMS)
CLOUDFLARE_EDGE_CACHE=true
CLOUDFLARE_HTML_EDGE_TTL=300
CLOUDFLARE_HTML_BROWSER_TTL=0
# Production tip: set CACHE_DRIVER=redis when Redis is available (same StorefrontCache keys).
# STOREFRONT_CMS_CACHE_TTL=86400
# STOREFRONT_SHOPIFY_CACHE_TTL=3600
# STOREFRONT_RELATED_CACHE_TTL=86400
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="contact@dainely.com"
MAIL_FROM_NAME="${APP_NAME}"

# Company contact (used in header, footer, contact page)
# COMPANY_EMAIL=contact@dainely.com
# COMPANY_PHONE="+1 800-721-1224"
# COMPANY_PHONE_TEL=+18007211224

# Square Payments
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_VERIFY_SSL=true
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Shopify (DMEDE USA)
SHOPIFY_SHOP_DOMAIN=dmede-usa.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2024-01
SHOPIFY_VERIFY_SSL=false
SHOPIFY_USE_STOREFRONT_CATALOG=true
# Prefer webhook-warmed local cache over live Shopify API (checkout still uses fresh: true)
SHOPIFY_STOREFRONT_LOCAL_FIRST=true
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_PRODUCT_CACHE_TTL=900
SHOPIFY_SYNC_ORDERS=true
SHOPIFY_TAX_ENABLED=true
SHOPIFY_TAX_CACHE_TTL=1800
SHOPIFY_TAX_FALLBACK=false
SHOPIFY_SHOP_CURRENCY=USD
SHOPIFY_WEBHOOK_SECRET=

# Shopify Storefront API
SHOPIFY_STOREFRONT_DOMAIN=dmede-usa.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_NATIVE_CHECKOUT=true
SHOPIFY_CHECKOUT_RETURN_URL="${APP_URL}"
FEATURES_SQUARE_FALLBACK=true

# Currency / Exchange Rates
OPEN_EXCHANGE_RATES_APP_ID=
BASE_CURRENCY=USD

# Google Analytics (browser gtag + server Measurement Protocol)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# Meta / Facebook Conversions API
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# META_TEST_EVENT_CODE=

# Analytics pipeline
ANALYTICS_ENABLED=true

# Trustpilot
TRUSTPILOT_BUSINESS_UNIT_ID=

# IP Geolocation (locale auto-redirect for VPN / regional visitors)
GEO_LOCALE_ENABLED=true
GEO_LOCALE_CACHE_TTL=86400
# Local dev only — simulate VPN country without leaving home (FR or DE)
# GEO_TEST_COUNTRY=FR
IPAPI_KEY=

# Optional: Square settlement currency (always USD for DMEDE gateway). Display stays EUR on /fr /de.
SQUARE_CHARGE_CURRENCY=USD

# Judge.me Reviews
JUDGEME_API_TOKEN=
JUDGEME_SHOP_DOMAIN=ididit555.myshopify.com
JUDGEME_CACHE_TTL=86400
JUDGEME_USE_COUNT_API=true
JUDGEME_SHOP_TOTALS_FALLBACK=true

# Phase 2 §12 webhook secrets (optional — validate when signature header is sent)
JUDGE_WEBHOOK_SECRET=
JUDGEME_WEBHOOK_SECRET=
VIDEO_AI_WEBHOOK_SECRET=
WALLPASS_WEBHOOK_SECRET=
JUDGE_WEBHOOK_BEARER=
VIDEO_AI_WEBHOOK_BEARER=
WALLPASS_WEBHOOK_BEARER=

# Admin Security
ADMIN_MFA_ENABLED=true

# Optional — higher-quality EN→FR/DE overlay translation (otherwise free MyMemory is used)
# DEEPL_API_KEY=
# DEEPL_API_FREE=true
