APP_NAME="Dainely"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Live hosting only: absolute path to web docroot if not public/ (e.g. dev.dainelylab.com folder)
# APP_PUBLIC_PATH=
APP_LOCALE=en
APP_SUPPORTED_LOCALES=en,fr,de

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supabase PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

# Supabase dedicated connection (catalog sync tables)
DB_SUPABASE_HOST=db.xxxxxxxxxxxx.supabase.co
DB_SUPABASE_PORT=5432
DB_SUPABASE_DATABASE=postgres
DB_SUPABASE_USERNAME=postgres
DB_SUPABASE_PASSWORD=
DB_SUPABASE_SSLMODE=require

# Supabase API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="contact@dainelylab.com"
MAIL_FROM_NAME="${APP_NAME}"

# Company contact (used in header, footer, contact page)
# COMPANY_EMAIL=contact@dainelylab.com
# COMPANY_PHONE="+1 800-721-1224"
# COMPANY_PHONE_TEL=+18007211224

# Square Payments
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_VERIFY_SSL=true
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Shopify (DMEDE USA)
SHOPIFY_SHOP_DOMAIN=dmede-usa.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2024-01
SHOPIFY_VERIFY_SSL=false
SHOPIFY_USE_STOREFRONT_CATALOG=true
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_PRODUCT_CACHE_TTL=900
SHOPIFY_SYNC_ORDERS=true
SHOPIFY_TAX_ENABLED=true
SHOPIFY_TAX_CACHE_TTL=300
SHOPIFY_TAX_FALLBACK=false
SHOPIFY_SHOP_CURRENCY=USD
SHOPIFY_WEBHOOK_SECRET=

# Shopify Storefront API
SHOPIFY_STOREFRONT_DOMAIN=dmede-usa.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
FEATURES_SQUARE_FALLBACK=true

# Currency / Exchange Rates
OPEN_EXCHANGE_RATES_APP_ID=
BASE_CURRENCY=USD

# Google Analytics
GA4_MEASUREMENT_ID=

# Trustpilot
TRUSTPILOT_BUSINESS_UNIT_ID=

# IP Geolocation (locale auto-redirect for VPN / regional visitors)
GEO_LOCALE_ENABLED=true
GEO_LOCALE_CACHE_TTL=86400
# Local dev only — simulate VPN country without leaving home (FR or DE)
# GEO_TEST_COUNTRY=FR
IPAPI_KEY=

# Optional: Square settlement currency (always USD for DMEDE gateway). Display stays EUR on /fr /de.
SQUARE_CHARGE_CURRENCY=USD

# Judge.me Reviews
JUDGEME_API_TOKEN=
JUDGEME_SHOP_DOMAIN=ididit555.myshopify.com
JUDGEME_CACHE_TTL=86400

# Admin Security
ADMIN_MFA_ENABLED=true
