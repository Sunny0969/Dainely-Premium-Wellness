APP_NAME="Dainely"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_SUPPORTED_LOCALES=en,fr,de

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dainely
# DB_USERNAME=root
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@dainely.com"
MAIL_FROM_NAME="${APP_NAME}"

# Square Payments
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Shopify (DMEDE.com)
SHOPIFY_STORE_DOMAIN=dmede.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Sendlane
SENDLANE_API_KEY=
SENDLANE_API_SECRET=
SENDLANE_SUBDOMAIN=

# Currency / Exchange Rates
OPEN_EXCHANGE_RATES_APP_ID=
BASE_CURRENCY=USD

# Google Analytics
GA4_MEASUREMENT_ID=

# Trustpilot
TRUSTPILOT_BUSINESS_UNIT_ID=

# IP Geolocation (for locale detection)
IPAPI_KEY=

# Admin Security
ADMIN_MFA_ENABLED=true
